# Scratch directories. Every harness makes its own so they can run in
# parallel, so the pattern is general rather than a list that grows.
build*/
__pycache__/
*.vcd
*.log

# Harness inputs and outputs that are regenerated on every run.
*_bench.json
*_bench.v
*_dbg.json
*_dbg.v

# Real model weights, fetched on request by fetch_qwen.py, never committed.
qwen_weights/

# Every board package's SD card: the model, regenerated by board_zybo.py.
board_*/sd/
