    "name": "crc32_endpoint_16B",
    "description": "Fabric endpoint CRC32 datapath, 16 byte(s) per cycle, zlib/Ethernet compatible (reflected polynomial 0xEDB88320), sized for a 10 Gbps link",
    "top_module": "crc32",
    "unit": "byte",
    "parameters": {
      "data_width": 128,
      "crc_width": 32,
      "bytes_per_cycle": 16,
      "target_clock_mhz": 78.125,
      "polynomial": "0xEDB88320 reflected form of 0x04C11DB7"
    },
    "derivation": {
      "target_link_gbps": 10.0,
