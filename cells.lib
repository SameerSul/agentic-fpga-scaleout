/* Minimal generic cell library for the prototype flow: enough for yosys
   dfflibmap/abc mapping and OpenSTA timing. Delays are illustrative. */
library(protolib) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit(1, pf);
  nom_process : 1;
  nom_voltage : 1.8;
  nom_temperature : 25;
  operating_conditions(typ) { process : 1; voltage : 1.8; temperature : 25; }
  default_operating_conditions : typ;

  cell(INV) {
    area : 1;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(Y) {
      direction : output;
      max_capacitance : 0.5;
      function : "!A";
      timing() {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise(scalar) { values("0.06"); }
        rise_transition(scalar) { values("0.03"); }
        cell_fall(scalar) { values("0.06"); }
        fall_transition(scalar) { values("0.03"); }
      }
    }
  }

  cell(BUF) {
    area : 2;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(Y) {
      direction : output;
      max_capacitance : 0.5;
      function : "A";
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(scalar) { values("0.08"); }
        rise_transition(scalar) { values("0.03"); }
        cell_fall(scalar) { values("0.08"); }
        fall_transition(scalar) { values("0.03"); }
      }
    }
  }

  cell(NAND2) {
    area : 2;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) {
      direction : output;
      max_capacitance : 0.5;
      function : "!(A&B)";
      timing() {
        related_pin : "A B";
        timing_sense : negative_unate;
        cell_rise(scalar) { values("0.10"); }
        rise_transition(scalar) { values("0.04"); }
        cell_fall(scalar) { values("0.10"); }
        fall_transition(scalar) { values("0.04"); }
      }
    }
  }

  cell(NOR2) {
    area : 2;
    pin(A) { direction : input; capacitance : 0.005; }
    pin(B) { direction : input; capacitance : 0.005; }
    pin(Y) {
      direction : output;
      max_capacitance : 0.5;
      function : "!(A|B)";
      timing() {
        related_pin : "A B";
        timing_sense : negative_unate;
        cell_rise(scalar) { values("0.12"); }
        rise_transition(scalar) { values("0.04"); }
        cell_fall(scalar) { values("0.12"); }
        fall_transition(scalar) { values("0.04"); }
      }
    }
  }

  cell(DFF) {
    area : 6;
    ff(IQ, IQN) { next_state : "D"; clocked_on : "CK"; }
    pin(CK) { direction : input; clock : true; capacitance : 0.005; }
    pin(D) {
      direction : input;
      capacitance : 0.005;
      timing() {
        related_pin : "CK";
        timing_type : setup_rising;
        rise_constraint(scalar) { values("0.12"); }
        fall_constraint(scalar) { values("0.12"); }
      }
      timing() {
        related_pin : "CK";
        timing_type : hold_rising;
        rise_constraint(scalar) { values("0.05"); }
        fall_constraint(scalar) { values("0.05"); }
      }
    }
    pin(Q) {
      direction : output;
      max_capacitance : 0.5;
      function : "IQ";
      timing() {
        related_pin : "CK";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise(scalar) { values("0.18"); }
        rise_transition(scalar) { values("0.05"); }
        cell_fall(scalar) { values("0.18"); }
        fall_transition(scalar) { values("0.05"); }
      }
    }
  }
}
