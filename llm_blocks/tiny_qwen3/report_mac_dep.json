      "rule": "acc_width = weight_bits + activation_bits + ceil(log2(max(d_model, d_ff)))",
      "signedness_rule": "symmetric quantization is two's complement signed, so operands, product and accumulator are all signed",
      "pipeline_stages": 3,
      "pipeline_rule": "2 stages up to an 8-bit datapath, 3 above it: the signed multiply is the critical path and splitting it into half-width partial products buys the clock back for one cycle of latency"
