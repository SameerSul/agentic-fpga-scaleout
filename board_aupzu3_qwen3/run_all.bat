@echo off
rem GENERATED by board_zu.py: the AUP-ZU3, from nothing built to text on the
rem UART, on Windows. Double-click it, or run it from this folder:
rem   run_all.bat                 build whatever is missing, then run
rem   run_all.bat rebuild         rebuild the bitstream and the program first
rem   run_all.bat COM5            also open PuTTY on COM5 at 115200
rem Needs Vivado and Vitis (2024.1 by default; set XILINX and XVER to change),
rem the AUP-ZU3 board files, the model files in sd\, the board on JTAG boot
rem mode with its USB connected and powered.
setlocal
if "%XILINX%"=="" set XILINX=C:\Xilinx
if "%XVER%"=="" set XVER=2024.1
set VIVADO=%XILINX%\Vivado\%XVER%\bin\vivado.bat
set VITIS=%XILINX%\Vitis\%XVER%\bin\vitis.bat
set XSCT=%XILINX%\Vitis\%XVER%\bin\xsct.bat
if not exist "%XSCT%" set XSCT=%XILINX%\Vitis\%XVER%\bin\xsdb.bat
cd /d "%~dp0"

if not exist "%VIVADO%" ( echo No Vivado at %VIVADO%: set XILINX or XVER. & goto fail )
if not exist "%VITIS%" ( echo No Vitis at %VITIS%: set XILINX or XVER. & goto fail )
if not exist "%XSCT%" ( echo No xsct or xsdb under %XILINX%\Vitis\%XVER%\bin. & goto fail )
for %%f in (weights8.bin cparams.bin vocab.bin prompt.bin) do (
  if not exist "sd\%%f" ( echo Missing sd\%%f: put the four model files in sd\ first ^(README.md step 1^). & goto fail )
)

set REBUILD=
set COM=
for %%a in (%*) do (
  if /i "%%a"=="rebuild" set REBUILD=1
  echo %%a| findstr /i /b "COM" >nul && set COM=%%a
)

if defined REBUILD del /q fpgai.bit fpgai.xsa psu_init.tcl sw\halo.elf 2>nul

if not exist fpgai.bit (
  echo === 1/3 Vivado: the bitstream, 20 to 40 minutes
  call "%VIVADO%" -mode batch -source build.tcl -log vivado_build.log -nojournal
  if not exist fpgai.bit ( echo Vivado did not write fpgai.bit: see vivado_build.log. & goto fail )
  if not exist psu_init.tcl (
    for /r vivado %%p in (psu_init.tcl) do if exist "%%p" copy /y "%%p" psu_init.tcl >nul
  )
  if not exist psu_init.tcl ( echo No psu_init.tcl from Vivado: see vivado_build.log. & goto fail )
  findstr /c:"All user specified timing constraints are met" timing.rpt >nul || echo WARNING: timing.rpt does not say timing is met; check WNS.
) else ( echo === 1/3 bitstream: fpgai.bit is there ^(run_all.bat rebuild to remake it^) )

if not exist sw\halo.elf (
  echo === 2/3 Vitis: the ARM program, a few minutes
  call "%VITIS%" -s sw\build_app.py
  if not exist sw\halo.elf ( echo Vitis did not write sw\halo.elf. & goto fail )
) else ( echo === 2/3 program: sw\halo.elf is there )

if defined COM (
  where putty >nul 2>nul && start "" putty -serial %COM% -sercfg 115200,8,n,1,N
  where putty >nul 2>nul || echo PuTTY is not on PATH: open %COM% at 115200 8N1 yourself.
) else (
  echo Open the board's COM port at 115200 8N1 now ^(PuTTY^), then
  pause
)

echo === 3/3 JTAG: program the PL, psu_init, load the model ^(minutes^), run
call "%XSCT%" sw\run_jtag.tcl
if errorlevel 1 goto fail
echo Done: the text is on the UART.
exit /b 0

:fail
echo FAILED
pause
exit /b 1
