    },
    "derivation": {
      "model": "gpt2_124m",
      "activation_bits": 8,
      "rule": "exp(x) = 2**(x*log2(e)); the integer part of x*log2(e) is an arithmetic right shift and the fractional part indexes a 256-entry table of 2**f",
      "log2e_q16": 94548
    },
    "ports": [
      {
