{
  "spec": {
    "name": "exp16_gpt2_124m",
    "description": "Fixed-point exponential for the attention softmax: Q7.8 signed input constrained to be non-positive, Q0.15 unsigned output, by a 256-entry table of 2**f and an arithmetic shift",
    "top_module": "expu",
    "unit": "score",
    "parameters": {
