{
  "spec": {
    "name": "requant8_gpt2_124m",
    "description": "Requantization unit derived from gpt2_124m: scales a 28-bit signed accumulator back to a 8-bit signed operand by a fixed-point multiply, arithmetic shift with round to nearest, and saturation",
    "top_module": "requant",
    "unit": "activation",
    "parameters": {
      "acc_width": 28,
      "out_width": 8,
      "scale_width": 18,
      "shift_width": 7,
      "scale_splits": 3,
      "signed": true,
      "pipeline_stages": 6,
      "target_clock_mhz": 100
    },
    "derivation": {
      "model": "gpt2_124m",
      "weight_bits": 8,
      "activation_bits": 8,
      "reduction_depth": 3072,
      "rule": "in_width = acc_width from the chiplet derivation; out_width = max(weight_bits, activation_bits); the scale is a 18-bit fixed-point multiplier with a run-time arithmetic shift"
    },
    "ports": [
      {
        "name": "clk",
        "dir": "input",
        "width": 1,
        "desc": "clock, rising edge"
      },
      {
        "name": "rst_n",
        "dir": "input",
        "width": 1,
        "desc": "active-low synchronous reset"
      },
      {
        "name": "acc_in",
        "dir": "input",
        "width": 28,
        "signed": true,
        "desc": "accumulator from the MAC, signed two's complement"
      },
      {
        "name": "scale",
        "dir": "input",
        "width": 18,
        "signed": false,
        "desc": "fixed-point multiplier, unsigned"
      },
      {
        "name": "shift",
        "dir": "input",
        "width": 7,
        "desc": "arithmetic right shift applied after the multiply"
      },
      {
        "name": "valid_in",
        "dir": "input",
        "width": 1,
        "desc": "acc_in valid"
      },
      {
        "name": "q_out",
        "dir": "output",
        "width": 8,
        "signed": true,
        "desc": "requantized activation, saturated not wrapped"
      },
      {
        "name": "sat",
        "dir": "output",
        "width": 1,
        "desc": "high when this output saturated"
      },
      {
        "name": "valid_out",
        "dir": "output",
        "width": 1,
        "desc": "q_out updated this cycle"
      }
    ],
    "behavior": [
      "Stage 1 registers two half-width partial products of acc_in * scale; stage 2 recombines them into the full product.",
      "Stage 3 adds half an LSB, precomputed a stage earlier, for round to nearest.",
      "Stage 4 arithmetically shifts that sum right by shift.",
      "Stage 5 saturates to the signed 8-bit range [-128, 127] and registers the result.",
      "sat is high on any output that had to be clamped.",
      "Saturating, not wrapping, is required: a wrapped overflow flips the sign of a large activation and corrupts every later layer.",
      "Latency from valid_in to valid_out is 6 cycles."
    ]
  },
  "tools": {
    "iverilog": "/opt/homebrew/bin/iverilog",
    "vvp": "/opt/homebrew/bin/vvp",
    "yosys": "/opt/homebrew/bin/yosys",
    "sta": "/Users/ssuleman/.local/bin/sta"
  },
